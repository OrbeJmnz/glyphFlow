{
  "name": "glyphflow-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ssr": "ng build glyphflow --configuration production && tsx scripts/ssr-smoke-test.ts",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p projects/glyphflow/tsconfig.lib.json && tsc --noEmit -p projects/playground/tsconfig.app.json",
    "bundle-check": "ng build glyphflow --configuration production && tsx scripts/bundle-size-check.ts",
    "pack-check": "ng build glyphflow --configuration production && tsx scripts/pack-check.ts",
    "notice-check": "node scripts/notice-check.mjs",
    "verify:clean": "node scripts/verify-clean.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-server": "^22.1.2",
    "@angular/ssr": "^22.1.4",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
