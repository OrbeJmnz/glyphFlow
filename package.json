{
  "name": "glyphflow-workspace",
  "version": "0.0.0",
  "scripts": {
    "build": "ng build",
    "build:lib": "npm run sync:package-files && ng build glyphflow --configuration production",
    "bundle-check": "npm run build:lib && tsx scripts/bundle-size-check.ts",
    "curated:lock": "tsx scripts/curated-lock.mjs",
    "curated:lock:check": "tsx scripts/curated-lock.mjs --check",
    "docs:check": "tsx scripts/docs-check.ts",
    "gen:examples": "tsx scripts/gen-examples.ts",
    "gen:examples:check": "tsx scripts/gen-examples.ts --check",
    "gen:variants": "tsx scripts/gen-icon-variants.ts",
    "gen:variants:check": "tsx scripts/gen-icon-variants.ts --check",
    "gen:docs-index": "tsx scripts/gen-docs-index.ts",
    "gen:docs-index:check": "tsx scripts/gen-docs-index.ts --check",
    "gen:catalogo": "tsx scripts/gen-catalogo-json.ts",
    "gen:catalogo:check": "tsx scripts/gen-catalogo-json.ts --check",
    "gen:playground-tags": "tsx scripts/gen-playground-tags.ts",
    "gen:sitemap": "tsx scripts/gen-sitemap.ts",
    "gen:sitemap:check": "tsx scripts/gen-sitemap.ts --check",
    "gen:springs": "tsx scripts/gen-spring-easings.ts",
    "gen:springs:check": "tsx scripts/gen-spring-easings.ts --check",
    "generate:icons": "tsx scripts/generate-lucide-icons.ts",
    "lint": "ng lint",
    "lucide:diff": "tsx scripts/lucide-diff-report.mjs",
    "morph-quality-report": "tsx scripts/morph-quality-report.ts",
    "morph-quality-report:check": "tsx scripts/morph-quality-report.ts --check",
    "motion-lint": "tsx scripts/motion-lint.ts",
    "ng": "ng",
    "notice-check": "node scripts/notice-check.mjs",
    "pack-check": "npm run build:lib && tsx scripts/pack-check.ts",
    "release": "npm run build:lib && node scripts/release.mjs",
    "snippets:check": "tsx scripts/snippets-check.ts",
    "start": "ng serve",
    "sync:package-files": "node scripts/sync-package-files.mjs",
    "sync:package-files:check": "node scripts/sync-package-files.mjs --check",
    "test": "ng test",
    "test:ssr": "npm run build:lib && tsx scripts/ssr-smoke-test.ts",
    "typecheck": "tsc --noEmit -p projects/glyphflow/tsconfig.lib.json && tsc --noEmit -p projects/playground/tsconfig.app.json",
    "verify:clean": "node scripts/verify-clean.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "projects/glyphflow"
  ],
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@jsverse/transloco": "^8.4.0",
    "glyphflow-published": "npm:glyphflow@^2.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/platform-server": "22.1.2",
    "@angular/ssr": "22.1.4",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "lucide-static": "1.31.0",
    "ng-packagr": "^22.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
