/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  // Array de `extends`: el último gana. Los `paths` viven en tsconfig.paths.json, compartidos con
  // tsconfig.spec.json — no se duplican aquí.
  "extends": ["../../tsconfig.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "types": [],
    // Las traducciones se importan como módulo (`import('../i18n/en.json')`), no por HttpClient —
    // ver `core/i18n-loader.ts`. Sin esto TS no tipa el `import()` de un `.json`.
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
