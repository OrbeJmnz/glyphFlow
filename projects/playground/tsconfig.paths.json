/* Los `paths` del playground, en UN solo lugar.
 *
 * `tsconfig.app.json` y `tsconfig.spec.json` lo heredan vía `extends` en array (TS 5.0+; aquí
 * corre 6.0), donde el último gana: primero la config de la raíz, después esta, que reemplaza sus
 * `paths` enteros. `paths` NUNCA se fusiona entre configs — el hijo pisa al padre completo, y por
 * eso el mapeo de la raíz (`glyphflow` → ./dist/glyphflow) desaparece aquí en vez de sumarse.
 *
 * Las rutas relativas de `paths` se resuelven contra el archivo que las DECLARA, no contra el que
 * hereda: por eso viven en projects/playground/, junto a los dos configs que las usan.
 *
 * Duplicar esto costó caro una vez: el alias de morph quedó solo en tsconfig.app.json y
 * `ng test playground` tronó con TS2307 mientras el build pasaba tranquilo.
 */
{
  "compilerOptions": {
    "paths": {
      // El playground consume el paquete PUBLICADO, no dist/. Con `workspaces`,
      // node_modules/glyphflow es un junction al código fuente, así que ni el mapeo de la raíz ni
      // la resolución normal llegan al paquete real: de ahí el alias.
      "glyphflow": ["../../node_modules/glyphflow-published"],
      // Morph SÍ está publicado (1.1.0), pero aquí sigue resolviendo al código local, y no por
      // pereza: el chunk publicado de morph importa `glyphflow` por NOMBRE DE PAQUETE — la regla
      // que evita que se duplique el InjectionToken. En un consumidor real eso resuelve al
      // paquete; en este workspace `node_modules/glyphflow` es un junction al código fuente, así
      // que no resuelve. El builder de la app aplica estos `paths` a todo y compila igual (probado
      // escondiendo la carpeta fuente), pero el runner de tests NO los aplica dentro de
      // dependencias y truena con "Failed to resolve import glyphflow".
      //
      // La salida de verdad es instalar el paquete publicado en un node_modules propio del
      // playground (projects/playground/package.json + install anidado), que es como se ve un
      // consumidor de a de veras. Eso toca CI y Vercel, así que es su propio slice.
      "glyphflow/morph": ["../glyphflow/morph/src/public-api"],
      // Los bots YA están publicados (3.2.0) y aun así resuelven a la fuente local, por la misma razón que morph: sus chunks publicados
      // importan `glyphflow` y `glyphflow/bots…` por NOMBRE DE PAQUETE, y aquí `node_modules/glyphflow` es un junction al código fuente. El
      // builder aplica estos `paths` a todo, pero typecheck y el runner de tests no los aplican dentro de la dependencia (TS2307 / "Failed to
      // resolve import"). Probado el 2026-10-08: quitarlos rompe `verify:clean` en el typecheck. Se van los dos juntos, bots y morph, el día que
      // el playground tenga su propio node_modules (el slice de arriba).
      // Mientras sigan, el tope de `anyComponentStyle` de angular.json se queda en 40kB: el CSS de `<gf-bot>` pesa ~38kB y, compilado desde
      // la fuente, cuenta contra ese tope (publicado llega embebido y no se mide: comprobado con una app Angular 22 limpia).
      "glyphflow/bots": ["../glyphflow/bots/src/public-api"],
      "glyphflow/bots/gestures": ["../glyphflow/bots/gestures/src/public-api"],
      "glyphflow/bots/extras": ["../glyphflow/bots/extras/src/public-api"],
      "glyphflow/bots/ai": ["../glyphflow/bots/ai/src/public-api"]
    }
  }
}
