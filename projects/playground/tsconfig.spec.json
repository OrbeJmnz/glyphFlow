/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  // Mismos `paths` que la app, por herencia real (tsconfig.paths.json) y no por copia: los specs
  // compilan el mismo árbol de componentes, y si los dos configs divergen el build pasa mientras
  // `ng test` truena con TS2307. Ya pasó.
  "extends": ["../../tsconfig.json", "./tsconfig.paths.json"],
  "compilerOptions": {
    "types": ["vitest/globals"],
    "resolveJsonModule": true
  },
  "include": ["src/**/*.d.ts", "src/**/*.spec.ts", "src/test-setup.ts"]
}
