/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": []
  },
  // `morph/` y `bots/` son entry points secundarios (`glyphflow/morph`, `glyphflow/bots`): viven
  // fuera de `src/` porque ng-packagr identifica cada entry point por su carpeta con `ng-package.json`.
  "include": ["src/**/*.ts", "morph/**/*.ts", "bots/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
